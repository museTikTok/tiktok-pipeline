[
 {
  "text": "At four seventeen in the morning,",
  "start": 0.0,
  "end": 1.64
 },
 {
  "text": "while everyone was asleep,",
  "start": 2.0,
  "end": 3.32
 },
 {
  "text": "the ground opened up.",
  "start": 3.82,
  "end": 4.96
 },
 {
  "text": "Hours later, the aftershocks",
  "start": 7.0,
  "end": 8.94
 },
 {
  "text": "were still bringing buildings down.",
  "start": 8.94,
  "end": 10.5
 },
 {
  "text": "CCTV caught it.",
  "start": 12.3,
  "end": 13.72
 },
 {
  "text": "Four eighteen in Malatya.",
  "start": 14.12,
  "end": 15.74
 },
 {
  "text": "The street itself was moving.",
  "start": 16.2,
  "end": 17.58
 },
 {
  "text": "One minute later, Diyarbakir.",
  "start": 24.3,
  "end": 26.12
 },
 {
  "text": "A magnitude seven point eight earthquake —",
  "start": 26.72,
  "end": 28.98
 },
 {
  "text": "the biggest in Turkey in over eighty years.",
  "start": 29.48,
  "end": 31.82
 },
 {
  "text": "Then a second quake, nine hours later.",
  "start": 36.0,
  "end": 38.3
 },
 {
  "text": "Nearly sixty thousand people.",
  "start": 38.66,
  "end": 40.2
 },
 {
  "text": "Two hundred fourteen thousand buildings gone.",
  "start": 40.68,
  "end": 42.72
 },
 {
  "text": "The buildings folded, floor onto floor.",
  "start": 44.8,
  "end": 47.12
 },
 {
  "text": "But in Gaziantep, the nurses",
  "start": 49.0,
  "end": 50.8
 },
 {
  "text": "ran toward the patients — not away.",
  "start": 50.8,
  "end": 53.02
 },
 {
  "text": "They carried the children out",
  "start": 53.54,
  "end": 54.94
 },
 {
  "text": "as the building shook.",
  "start": 54.94,
  "end": 56.3
 }
]
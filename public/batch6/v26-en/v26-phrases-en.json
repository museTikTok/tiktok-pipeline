[
 {
  "text": "At 4:17 in the morning,",
  "start": 0.0,
  "end": 1.78
 },
 {
  "text": "while everyone was asleep,",
  "start": 1.8,
  "end": 3.52
 },
 {
  "text": "the ground opened up.",
  "start": 3.98,
  "end": 5.14
 },
 {
  "text": "Hours later, the aftershocks",
  "start": 7.0,
  "end": 8.96
 },
 {
  "text": "were still bringing buildings down.",
  "start": 8.96,
  "end": 10.58
 },
 {
  "text": "CCTV caught it.",
  "start": 12.3,
  "end": 13.7
 },
 {
  "text": "4:18 in Malatya.",
  "start": 13.7,
  "end": 15.74
 },
 {
  "text": "The street itself was moving.",
  "start": 16.16,
  "end": 17.62
 },
 {
  "text": "One minute later, Diyarbakir.",
  "start": 24.3,
  "end": 26.1
 },
 {
  "text": "A magnitude 7.8 earthquake —",
  "start": 26.68,
  "end": 28.96
 },
 {
  "text": "the biggest in Turkey in over eighty years.",
  "start": 29.48,
  "end": 31.7
 },
 {
  "text": "Then a second quake, nine hours later.",
  "start": 36.0,
  "end": 37.98
 },
 {
  "text": "Nearly 60,000 people.",
  "start": 38.4,
  "end": 40.7
 },
 {
  "text": "214,000 buildings gone.",
  "start": 41.18,
  "end": 44.14
 },
 {
  "text": "The buildings folded, floor onto floor.",
  "start": 44.8,
  "end": 47.2
 },
 {
  "text": "But in Gaziantep, the nurses",
  "start": 49.0,
  "end": 50.82
 },
 {
  "text": "ran toward the patients — not away.",
  "start": 50.82,
  "end": 53.02
 },
 {
  "text": "They carried the children out",
  "start": 53.64,
  "end": 55.14
 },
 {
  "text": "as the building shook.",
  "start": 55.14,
  "end": 56.46
 }
]
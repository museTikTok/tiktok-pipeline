[
 {
  "text": "They had eighteen hours",
  "start": 0.0,
  "end": 0.92
 },
 {
  "text": "to leave. Most stayed.",
  "start": 0.92,
  "end": 2.36
 },
 {
  "text": "In the year 79,",
  "start": 2.84,
  "end": 3.84
 },
 {
  "text": "Pompeii was a busy",
  "start": 4.32,
  "end": 5.22
 },
 {
  "text": "Roman city beneath a mountain.",
  "start": 5.22,
  "end": 6.92
 },
 {
  "text": "That mountain was Vesuvius.",
  "start": 6.92,
  "end": 8.9
 },
 {
  "text": "One morning,",
  "start": 9.28,
  "end": 9.86
 },
 {
  "text": "it woke.",
  "start": 10.12,
  "end": 10.36
 },
 {
  "text": "A column of ash",
  "start": 10.98,
  "end": 11.8
 },
 {
  "text": "rose thirty-three kilometres high.",
  "start": 11.8,
  "end": 13.68
 },
 {
  "text": "The energy of a",
  "start": 14.22,
  "end": 14.9
 },
 {
  "text": "hundred thousand Hiroshimas.",
  "start": 14.88,
  "end": 16.6
 },
 {
  "text": "Then came the surge",
  "start": 16.6,
  "end": 17.86
 },
 {
  "text": "seven hundred degrees,",
  "start": 17.86,
  "end": 19.24
 },
 {
  "text": "faster than a car.",
  "start": 19.24,
  "end": 20.74
 },
 {
  "text": "In hours,",
  "start": 21.24,
  "end": 21.66
 },
 {
  "text": "it buried Pompeii,",
  "start": 21.86,
  "end": 22.88
 },
 {
  "text": "Herculaneum, and two more.",
  "start": 23.12,
  "end": 24.4
 },
 {
  "text": "Centuries later,",
  "start": 24.98,
  "end": 25.78
 },
 {
  "text": "archaeologists filled the voids",
  "start": 26.0,
  "end": 27.64
 },
 {
  "text": "with plaster.",
  "start": 27.64,
  "end": 28.24
 },
 {
  "text": "More than fifteen hundred",
  "start": 28.58,
  "end": 29.74
 },
 {
  "text": "were found. The true",
  "start": 29.74,
  "end": 31.14
 },
 {
  "text": "number is unknown.",
  "start": 31.14,
  "end": 32.04
 },
 {
  "text": "They had eighteen hours.",
  "start": 32.62,
  "end": 33.64
 },
 {
  "text": "Only 3 of us",
  "start": 34.08,
  "end": 34.94
 },
 {
  "text": "here. Follow to join",
  "start": 34.94,
  "end": 36.4
 },
 {
  "text": "the 10,000.",
  "start": 36.4,
  "end": 37.92
 }
]
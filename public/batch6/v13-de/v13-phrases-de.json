[
 {
  "text": "Das Meer verschwand. Dann",
  "start": 0.0,
  "end": 1.66
 },
 {
  "text": "kam es als Mauer zurück.",
  "start": 1.66,
  "end": 2.92
 },
 {
  "text": "Am 26. Dezember 2004",
  "start": 3.54,
  "end": 6.28
 },
 {
  "text": "riss der Meeresboden vor",
  "start": 6.28,
  "end": 7.74
 },
 {
  "text": "Sumatra in einem Erdbeben",
  "start": 7.74,
  "end": 9.34
 },
 {
  "text": "der Stärke 9,1 auf.",
  "start": 9.34,
  "end": 10.62
 },
 {
  "text": "Das Beben dauerte fast",
  "start": 11.24,
  "end": 12.36
 },
 {
  "text": "zehn Minuten,",
  "start": 12.36,
  "end": 13.08
 },
 {
  "text": "das längste,",
  "start": 13.44,
  "end": 14.02
 },
 {
  "text": "das je gemessen wurde.",
  "start": 14.18,
  "end": 15.22
 },
 {
  "text": "Im tiefen Ozean bewegte",
  "start": 15.8,
  "end": 17.38
 },
 {
  "text": "sich die Welle mit",
  "start": 17.38,
  "end": 18.24
 },
 {
  "text": "der Geschwindigkeit eines Düsenjets.",
  "start": 18.24,
  "end": 19.92
 },
 {
  "text": "An den Stränden Thailands",
  "start": 20.56,
  "end": 21.64
 },
 {
  "text": "zog sich das Wasser",
  "start": 21.64,
  "end": 22.66
 },
 {
  "text": "zurück und legte den",
  "start": 22.66,
  "end": 24.02
 },
 {
  "text": "Meeresboden frei.",
  "start": 24.02,
  "end": 24.86
 },
 {
  "text": "Die Menschen gingen hinaus,",
  "start": 25.44,
  "end": 26.68
 },
 {
  "text": "um zu schauen. Dann",
  "start": 26.68,
  "end": 28.14
 },
 {
  "text": "kam die Welle.",
  "start": 28.14,
  "end": 28.82
 },
 {
  "text": "In Khao Lak stürzte",
  "start": 28.82,
  "end": 30.52
 },
 {
  "text": "eine Wasserwand über den",
  "start": 30.52,
  "end": 31.78
 },
 {
  "text": "Strand und riss alles",
  "start": 31.78,
  "end": 32.9
 },
 {
  "text": "mit sich.",
  "start": 32.9,
  "end": 33.42
 },
 {
  "text": "Das Wasser kam stundenlang",
  "start": 33.94,
  "end": 35.28
 },
 {
  "text": "weiter, ein schwarzer Fluss",
  "start": 35.28,
  "end": 36.84
 },
 {
  "text": "aus Autos,",
  "start": 36.84,
  "end": 37.5
 },
 {
  "text": "Bäumen und Beton.",
  "start": 37.7,
  "end": 38.58
 },
 {
  "text": "In Banda Aceh löschten",
  "start": 39.18,
  "end": 40.54
 },
 {
  "text": "bis zu dreißig Meter",
  "start": 40.54,
  "end": 41.68
 },
 {
  "text": "hohe Wellen ganze Viertel aus.",
  "start": 41.68,
  "end": 43.28
 },
 {
  "text": "In Sri Lanka riss",
  "start": 43.94,
  "end": 44.82
 },
 {
  "text": "die Welle einen voll",
  "start": 44.82,
  "end": 45.9
 },
 {
  "text": "besetzten Zug von den Schienen.",
  "start": 45.9,
  "end": 47.48
 },
 {
  "text": "Der Tsunami raste über",
  "start": 48.1,
  "end": 49.42
 },
 {
  "text": "den Indischen Ozean und",
  "start": 49.42,
  "end": 50.92
 },
 {
  "text": "erreichte vierzehn Länder.",
  "start": 50.92,
  "end": 52.08
 },
 {
  "text": "Es gab kein Warnsystem.",
  "start": 52.72,
  "end": 54.14
 },
 {
  "text": "Keine Sirenen. Keine Zeit",
  "start": 54.46,
  "end": 55.92
 },
 {
  "text": "zu fliehen.",
  "start": 55.92,
  "end": 56.48
 },
 {
  "text": "Als das Wasser zurückging,",
  "start": 56.48,
  "end": 58.24
 },
 {
  "text": "waren 227.898 Menschen tot.",
  "start": 58.62,
  "end": 62.28
 },
 {
  "text": "227.898 Menschen kamen nie",
  "start": 64.22,
  "end": 66.7
 },
 {
  "text": "nach Hause.",
  "start": 66.7,
  "end": 67.2
 }
]
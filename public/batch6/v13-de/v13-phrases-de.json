[
 {
  "text": "Eine Welle verschlang eine",
  "start": 0.0,
  "end": 1.6
 },
 {
  "text": "ganze Stadt.",
  "start": 1.6,
  "end": 2.28
 },
 {
  "text": "Am 26. Dezember 2004",
  "start": 2.88,
  "end": 5.62
 },
 {
  "text": "riss der Meeresboden vor",
  "start": 5.62,
  "end": 7.08
 },
 {
  "text": "Sumatra in einem Erdbeben",
  "start": 7.08,
  "end": 8.68
 },
 {
  "text": "der Stärke 9,1 auf.",
  "start": 8.68,
  "end": 9.98
 },
 {
  "text": "Das Beben dauerte fast",
  "start": 10.58,
  "end": 11.7
 },
 {
  "text": "zehn Minuten,",
  "start": 11.7,
  "end": 12.46
 },
 {
  "text": "das längste,",
  "start": 12.78,
  "end": 13.38
 },
 {
  "text": "das je gemessen wurde.",
  "start": 13.56,
  "end": 14.6
 },
 {
  "text": "Im tiefen Ozean bewegte",
  "start": 15.14,
  "end": 16.72
 },
 {
  "text": "sich die Welle mit",
  "start": 16.72,
  "end": 17.6
 },
 {
  "text": "der Geschwindigkeit eines Düsenjets.",
  "start": 17.6,
  "end": 19.28
 },
 {
  "text": "An den Stränden Thailands",
  "start": 19.9,
  "end": 21.0
 },
 {
  "text": "zog sich das Wasser",
  "start": 21.0,
  "end": 22.02
 },
 {
  "text": "zurück und legte den",
  "start": 22.02,
  "end": 23.36
 },
 {
  "text": "Meeresboden frei.",
  "start": 23.36,
  "end": 24.2
 },
 {
  "text": "Die Menschen gingen hinaus,",
  "start": 24.8,
  "end": 26.04
 },
 {
  "text": "um zu schauen. Dann",
  "start": 26.36,
  "end": 27.48
 },
 {
  "text": "kam die Welle.",
  "start": 27.48,
  "end": 28.16
 },
 {
  "text": "In Khao Lak stürzte",
  "start": 28.16,
  "end": 29.88
 },
 {
  "text": "eine Wasserwand über den",
  "start": 29.88,
  "end": 31.12
 },
 {
  "text": "Strand und riss alles",
  "start": 31.12,
  "end": 32.24
 },
 {
  "text": "mit sich.",
  "start": 32.24,
  "end": 32.76
 },
 {
  "text": "Das Wasser kam stundenlang",
  "start": 33.3,
  "end": 34.62
 },
 {
  "text": "weiter, ein schwarzer Fluss",
  "start": 34.62,
  "end": 36.18
 },
 {
  "text": "aus Autos,",
  "start": 36.18,
  "end": 36.84
 },
 {
  "text": "Bäumen und Beton.",
  "start": 37.08,
  "end": 37.92
 },
 {
  "text": "In Banda Aceh löschten",
  "start": 38.54,
  "end": 39.88
 },
 {
  "text": "bis zu dreißig Meter",
  "start": 39.88,
  "end": 41.02
 },
 {
  "text": "hohe Wellen ganze Viertel aus.",
  "start": 41.02,
  "end": 42.62
 },
 {
  "text": "In Sri Lanka riss",
  "start": 43.3,
  "end": 44.16
 },
 {
  "text": "die Welle einen voll",
  "start": 44.16,
  "end": 45.26
 },
 {
  "text": "besetzten Zug von den Schienen.",
  "start": 45.26,
  "end": 46.82
 },
 {
  "text": "Der Tsunami raste über",
  "start": 47.46,
  "end": 48.76
 },
 {
  "text": "den Indischen Ozean und",
  "start": 48.76,
  "end": 50.26
 },
 {
  "text": "erreichte vierzehn Länder.",
  "start": 50.26,
  "end": 51.4
 },
 {
  "text": "Es gab kein Warnsystem.",
  "start": 52.06,
  "end": 53.48
 },
 {
  "text": "Keine Sirenen. Keine Zeit",
  "start": 53.8,
  "end": 55.28
 },
 {
  "text": "zu fliehen.",
  "start": 55.28,
  "end": 55.84
 },
 {
  "text": "Als das Wasser zurückging,",
  "start": 55.84,
  "end": 57.6
 },
 {
  "text": "waren 227.898 Menschen tot.",
  "start": 57.96,
  "end": 61.64
 },
 {
  "text": "227.898 Menschen kamen nie",
  "start": 62.36,
  "end": 66.04
 },
 {
  "text": "nach Hause.",
  "start": 66.04,
  "end": 66.5
 }
]
[
 {
  "text": "A whole town saw",
  "start": 0.0,
  "end": 0.96
 },
 {
  "text": "a monster and then",
  "start": 0.96,
  "end": 2.08
 },
 {
  "text": "its bridge fell.",
  "start": 2.08,
  "end": 2.96
 },
 {
  "text": "On the night of",
  "start": 3.66,
  "end": 4.1
 },
 {
  "text": "November fifteenth,",
  "start": 4.1,
  "end": 5.0
 },
 {
  "text": "nineteen sixty-six,",
  "start": 5.0,
  "end": 6.16
 },
 {
  "text": "two couples drove past",
  "start": 6.78,
  "end": 7.96
 },
 {
  "text": "an abandoned munitions plant",
  "start": 7.96,
  "end": 9.38
 },
 {
  "text": "outside Point Pleasant.",
  "start": 9.38,
  "end": 10.82
 },
 {
  "text": "In their headlights stood",
  "start": 11.38,
  "end": 12.34
 },
 {
  "text": "a creature,",
  "start": 12.34,
  "end": 12.8
 },
 {
  "text": "two metres tall,",
  "start": 13.28,
  "end": 14.12
 },
 {
  "text": "with wings and eyes",
  "start": 14.4,
  "end": 15.8
 },
 {
  "text": "that glowed red.",
  "start": 15.8,
  "end": 16.74
 },
 {
  "text": "They fled at a",
  "start": 17.18,
  "end": 17.8
 },
 {
  "text": "hundred miles an hour.",
  "start": 17.8,
  "end": 19.04
 },
 {
  "text": "It flew after them, screaming.",
  "start": 19.5,
  "end": 20.88
 },
 {
  "text": "Over the next thirteen",
  "start": 21.48,
  "end": 22.26
 },
 {
  "text": "months, more than a",
  "start": 22.26,
  "end": 23.26
 },
 {
  "text": "hundred people said they",
  "start": 23.26,
  "end": 24.38
 },
 {
  "text": "saw it.",
  "start": 24.38,
  "end": 24.84
 },
 {
  "text": "Scientists had simpler answers:",
  "start": 24.84,
  "end": 26.94
 },
 {
  "text": "a sandhill crane,",
  "start": 27.46,
  "end": 28.28
 },
 {
  "text": "blown off course or",
  "start": 28.28,
  "end": 29.74
 },
 {
  "text": "a barn owl.",
  "start": 29.74,
  "end": 30.46
 },
 {
  "text": "A crane stands almost",
  "start": 30.98,
  "end": 32.08
 },
 {
  "text": "as tall as a",
  "start": 32.08,
  "end": 32.86
 },
 {
  "text": "man, with a seven-foot",
  "start": 32.86,
  "end": 34.24
 },
 {
  "text": "wingspan and red skin",
  "start": 34.24,
  "end": 35.8
 },
 {
  "text": "around its eyes.",
  "start": 35.8,
  "end": 36.72
 },
 {
  "text": "Then, on December fifteenth,",
  "start": 37.22,
  "end": 38.81
 },
 {
  "text": "nineteen sixty-seven,",
  "start": 38.81,
  "end": 40.18
 },
 {
  "text": "the town's bridge collapsed",
  "start": 40.8,
  "end": 42.12
 },
 {
  "text": "into the Ohio River.",
  "start": 42.12,
  "end": 43.42
 },
 {
  "text": "Forty-six people died.",
  "start": 43.92,
  "end": 45.08
 },
 {
  "text": "The investigation found the",
  "start": 45.68,
  "end": 46.94
 },
 {
  "text": "real cause: a single",
  "start": 46.94,
  "end": 48.36
 },
 {
  "text": "steel eye-bar,",
  "start": 48.36,
  "end": 49.2
 },
 {
  "text": "cracked by corrosion,",
  "start": 49.2,
  "end": 50.32
 },
 {
  "text": "had snapped.",
  "start": 50.32,
  "end": 51.1
 },
 {
  "text": "The creature never caused",
  "start": 51.1,
  "end": 52.58
 },
 {
  "text": "the collapse. But for",
  "start": 52.58,
  "end": 53.9
 },
 {
  "text": "the town,",
  "start": 53.9,
  "end": 54.36
 },
 {
  "text": "the two were forever linked.",
  "start": 54.66,
  "end": 55.68
 },
 {
  "text": "Today, a twelve-foot statue",
  "start": 56.22,
  "end": 57.68
 },
 {
  "text": "stands in Point Pleasant,",
  "start": 57.68,
  "end": 58.96
 },
 {
  "text": "and thousands come for",
  "start": 58.96,
  "end": 60.48
 },
 {
  "text": "its festival.",
  "start": 60.48,
  "end": 61.1
 },
 {
  "text": "Was it a monster,",
  "start": 61.5,
  "end": 62.3
 },
 {
  "text": "a bird or just",
  "start": 62.6,
  "end": 63.64
 },
 {
  "text": "a town,",
  "start": 63.64,
  "end": 64.22
 },
 {
  "text": "scared in the dark?",
  "start": 64.22,
  "end": 65.44
 }
]
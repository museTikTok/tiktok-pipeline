[
 {
  "text": "A wave swallowed a",
  "start": 0.0,
  "end": 0.98
 },
 {
  "text": "whole city.",
  "start": 0.98,
  "end": 1.58
 },
 {
  "text": "On December 26th,",
  "start": 2.1,
  "end": 3.68
 },
 {
  "text": "2004, the ocean floor",
  "start": 3.68,
  "end": 5.68
 },
 {
  "text": "off Sumatra tore open",
  "start": 5.68,
  "end": 7.18
 },
 {
  "text": "in a magnitude 9.1 earthquake.",
  "start": 7.18,
  "end": 9.38
 },
 {
  "text": "The shaking lasted almost",
  "start": 9.9,
  "end": 11.22
 },
 {
  "text": "ten minutes,",
  "start": 11.22,
  "end": 11.82
 },
 {
  "text": "the longest ever recorded.",
  "start": 12.26,
  "end": 13.48
 },
 {
  "text": "In the deep ocean,",
  "start": 14.02,
  "end": 14.86
 },
 {
  "text": "the wave moved at",
  "start": 15.12,
  "end": 16.02
 },
 {
  "text": "the speed of a",
  "start": 16.02,
  "end": 16.74
 },
 {
  "text": "jet airliner.",
  "start": 16.74,
  "end": 17.64
 },
 {
  "text": "Across the beaches of",
  "start": 18.1,
  "end": 19.12
 },
 {
  "text": "Thailand, the water pulled",
  "start": 19.12,
  "end": 20.66
 },
 {
  "text": "back, exposing the sea floor.",
  "start": 20.66,
  "end": 22.76
 },
 {
  "text": "People walked out to",
  "start": 23.22,
  "end": 24.14
 },
 {
  "text": "look. Then the wave arrived.",
  "start": 24.14,
  "end": 25.9
 },
 {
  "text": "In Khao Lak,",
  "start": 26.34,
  "end": 27.14
 },
 {
  "text": "a wall of water",
  "start": 27.38,
  "end": 28.12
 },
 {
  "text": "crashed over the beach,",
  "start": 28.12,
  "end": 29.14
 },
 {
  "text": "sweeping away everything in",
  "start": 29.14,
  "end": 30.7
 },
 {
  "text": "its path.",
  "start": 30.7,
  "end": 31.3
 },
 {
  "text": "The water kept coming",
  "start": 31.74,
  "end": 32.54
 },
 {
  "text": "for hours,",
  "start": 32.54,
  "end": 33.12
 },
 {
  "text": "a black river of",
  "start": 33.52,
  "end": 34.34
 },
 {
  "text": "cars, trees,",
  "start": 34.34,
  "end": 35.16
 },
 {
  "text": "and concrete.",
  "start": 35.16,
  "end": 36.02
 },
 {
  "text": "In Banda Aceh,",
  "start": 36.48,
  "end": 37.46
 },
 {
  "text": "waves up to thirty",
  "start": 37.86,
  "end": 38.7
 },
 {
  "text": "metres high erased whole neighbourhoods.",
  "start": 38.7,
  "end": 40.76
 },
 {
  "text": "In Sri Lanka,",
  "start": 41.28,
  "end": 42.06
 },
 {
  "text": "the wave swept a",
  "start": 42.44,
  "end": 43.32
 },
 {
  "text": "crowded train off its tracks.",
  "start": 43.32,
  "end": 44.98
 },
 {
  "text": "The tsunami raced across",
  "start": 45.48,
  "end": 46.64
 },
 {
  "text": "the Indian Ocean,",
  "start": 46.64,
  "end": 47.6
 },
 {
  "text": "reaching fourteen countries.",
  "start": 48.04,
  "end": 49.28
 },
 {
  "text": "There was no warning",
  "start": 49.82,
  "end": 50.64
 },
 {
  "text": "system. No sirens. No",
  "start": 50.64,
  "end": 52.98
 },
 {
  "text": "time to run.",
  "start": 52.98,
  "end": 53.74
 },
 {
  "text": "When the water went",
  "start": 54.14,
  "end": 54.96
 },
 {
  "text": "back, 227,898 people were dead.",
  "start": 54.96,
  "end": 59.42
 },
 {
  "text": "227,898 people never came home.",
  "start": 61.12,
  "end": 64.22
 }
]
[
 {
  "text": "The sea vanished. Then",
  "start": 0.0,
  "end": 1.34
 },
 {
  "text": "it returned as a wall.",
  "start": 1.34,
  "end": 2.56
 },
 {
  "text": "On December 26th,",
  "start": 3.18,
  "end": 4.34
 },
 {
  "text": "2004, the ocean floor",
  "start": 4.74,
  "end": 6.84
 },
 {
  "text": "off Sumatra tore open",
  "start": 6.84,
  "end": 8.36
 },
 {
  "text": "in a magnitude 9.1 earthquake.",
  "start": 8.36,
  "end": 10.78
 },
 {
  "text": "The shaking lasted almost",
  "start": 11.18,
  "end": 12.68
 },
 {
  "text": "ten minutes,",
  "start": 12.68,
  "end": 13.28
 },
 {
  "text": "the longest ever recorded.",
  "start": 13.76,
  "end": 14.98
 },
 {
  "text": "In the deep ocean,",
  "start": 15.52,
  "end": 16.44
 },
 {
  "text": "the wave moved at",
  "start": 16.86,
  "end": 17.74
 },
 {
  "text": "the speed of a",
  "start": 17.74,
  "end": 18.58
 },
 {
  "text": "jet airliner.",
  "start": 18.58,
  "end": 19.46
 },
 {
  "text": "Across the beaches of",
  "start": 19.86,
  "end": 20.68
 },
 {
  "text": "Thailand, the water pulled",
  "start": 20.68,
  "end": 22.04
 },
 {
  "text": "back, exposing the sea floor.",
  "start": 22.04,
  "end": 23.96
 },
 {
  "text": "People walked out to",
  "start": 23.96,
  "end": 25.32
 },
 {
  "text": "look. Then the wave arrived.",
  "start": 25.32,
  "end": 27.06
 },
 {
  "text": "In Khao Lak,",
  "start": 27.5,
  "end": 28.28
 },
 {
  "text": "a wall of water",
  "start": 28.48,
  "end": 29.16
 },
 {
  "text": "crashed over the beach,",
  "start": 29.16,
  "end": 30.14
 },
 {
  "text": "sweeping away everything in",
  "start": 30.48,
  "end": 31.72
 },
 {
  "text": "its path.",
  "start": 31.72,
  "end": 32.2
 },
 {
  "text": "The water kept coming",
  "start": 32.64,
  "end": 33.56
 },
 {
  "text": "for hours,",
  "start": 33.56,
  "end": 34.14
 },
 {
  "text": "a black river of",
  "start": 34.58,
  "end": 35.38
 },
 {
  "text": "cars, trees,",
  "start": 35.38,
  "end": 36.26
 },
 {
  "text": "and concrete.",
  "start": 36.6,
  "end": 37.2
 },
 {
  "text": "In Banda Aceh,",
  "start": 37.74,
  "end": 38.7
 },
 {
  "text": "waves up to thirty",
  "start": 39.04,
  "end": 39.92
 },
 {
  "text": "metres high erased whole neighbourhoods.",
  "start": 39.92,
  "end": 41.94
 },
 {
  "text": "In Sri Lanka,",
  "start": 42.54,
  "end": 43.18
 },
 {
  "text": "the wave swept a",
  "start": 43.44,
  "end": 44.3
 },
 {
  "text": "crowded train off its tracks.",
  "start": 44.3,
  "end": 45.92
 },
 {
  "text": "The tsunami raced across",
  "start": 46.42,
  "end": 47.58
 },
 {
  "text": "the Indian Ocean,",
  "start": 47.58,
  "end": 48.56
 },
 {
  "text": "reaching fourteen countries.",
  "start": 48.56,
  "end": 50.12
 },
 {
  "text": "There was no warning",
  "start": 50.48,
  "end": 51.36
 },
 {
  "text": "system. No sirens. No",
  "start": 51.36,
  "end": 53.6
 },
 {
  "text": "time to run.",
  "start": 53.6,
  "end": 54.38
 },
 {
  "text": "When the water went",
  "start": 54.8,
  "end": 55.52
 },
 {
  "text": "back, 227,898 people were dead.",
  "start": 55.52,
  "end": 59.74
 },
 {
  "text": "227,898 people never came home.",
  "start": 60.8,
  "end": 64.32
 }
]
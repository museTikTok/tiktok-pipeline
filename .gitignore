# --- Dependencies (rebuilt in CI: npm ci / pip install) ---
node_modules/
.venv/
__pycache__/
*.pyc

# --- Browsers (installed in CI: npx remotion browser install) ---
.browser/

# --- Render outputs & temp dirs ---
out/
out=/
.tmp/
.tmp-render/
*.mp4
*.webm
*.mov
!public/**/*.mp4
*.jpg
!assets/**/*.jpg
*.png
!assets/**/*.png

# --- Public assets NOT needed for the v7 test render ---
# (other videos' clips stay on the VM; add them here per video when needed)
public/batch3/
public/batch4/
public/batch5/
public/batch6/*
!public/batch6/v7-clips/
!public/batch6/v7-en/
!public/batch6/v7-de/
!public/batch6/v8-clips/
!public/batch6/v8-en/
!public/batch6/v8-en/v8-hook.jpg
!public/batch6/v8-de/
!public/batch6/v8-de/v8-hook-de.jpg
# VO speed backups stay on the VM (not needed in CI).
public/batch6/v8-de/*-backup.mp3
# Raw clip downloads stay on the VM (218 MB, not needed in CI).
public/batch6/v8-clips/raw/
# Words JSONs are required by the Remotion bundle: Root.tsx imports every
# video component, and each one require()s its words JSON at bundle time.
# (Run 1 failed on the missing v6-de words JSON.) Only the JSONs are
# whitelisted; the clips and VO of videos 3-6 stay on the VM.
!public/batch6/v3-words-fixed.json
!public/batch6/v3-en/
public/batch6/v3-en/*
!public/batch6/v3-en/v3-words-en-fixed.json
!public/batch6/v4-de/
public/batch6/v4-de/*
!public/batch6/v4-de/v4-words-de-fixed.json
!public/batch6/v4-en/
public/batch6/v4-en/*
!public/batch6/v4-en/v4-words-en-fixed.json
!public/batch6/v5-de/
public/batch6/v5-de/*
!public/batch6/v5-de/v5-words-de-fixed.json
!public/batch6/v5-en/
public/batch6/v5-en/*
!public/batch6/v5-en/v5-words-en-fixed.json
!public/batch6/v6-de/
public/batch6/v6-de/*
!public/batch6/v6-de/v6-words-de-fixed.json
!public/batch6/v6-en/
public/batch6/v6-en/*
!public/batch6/v6-en/v6-words-en-fixed.json
public/batch6/v7-clips/orig-uncropped/
public/clip1_full.mp4
public/clip2_full.mp4
public/kl-*.mp4
public/kl-*.mp3
public/ok-*.mp4
public/ok-*.mp3
